# Orchestrator LLM-first classification via LiteLLM proxy (standalone default)
ENABLE_LLM_CLASSIFIER=false
# Example: http://localhost:4000/v1
ORCHESTRATOR_LITELLM_PROXY_URL=http://localhost:4000/v1
# Managed-identity scope accepted by LiteLLM App Service Easy Auth.
# Example: api://<litellm-app-client-id>/.default
ORCHESTRATOR_LITELLM_SCOPE=
# Model name exposed by LiteLLM (for example: azure/gpt-4o or gpt-4o-mini)
ORCHESTRATOR_LLM_MODEL=
ORCHESTRATOR_LLM_TIMEOUT_SECONDS=8.0

# Shared deployment names (same pattern as SSC Assistant API)
GPT40_DEPLOYMENT_NAME=
DEFAULT_DEPLOYMENT_NAME=

# Routing behavior
ORCHESTRATOR_MIN_CONFIDENCE=0.4
